# Secrets
.env

# Local Claude Code files
.claude/
CLAUDE.md

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# cache/llm/ IS committed: every recorded model response, so results replay with no API key.
# Other caches (e.g. the intent-generation cache) are not needed to reproduce results.
cache/*
!cache/llm/

# Local SQLite call log (grows with every run)
*.sqlite
*.sqlite3

# Temporary / OS files
*.tmp
*.log
.DS_Store
